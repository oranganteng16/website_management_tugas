<!DOCTYPE html>
<html lang="id">
<head>
    <link rel="stylesheet" href="styles.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ManageTugas — Kanban Board Modern</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=fallback" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    
</head>
<body>

<div id="login-overlay-backdrop"></div>
<div id="login-screen" role="dialog" aria-modal="true" aria-label="Masuk ke Akun">
    <div class="login-layout">
        <!-- Left Side -->
        <div class="login-left">
            <div class="logo-wrapper">
                <div class="logo-icon">
                    <span class="material-icons-round">task_alt</span>
                </div>
                <div class="logo-text">
                    <h1>ManageTugas</h1>
                    <p>Manajemen Tugas Modern</p>
                </div>
            </div>
            <p class="subtitle">
                Board modern untuk mengelola tugas, proyek, dan deadline tim Anda dengan mudah.
                <br>Akses cepat ke kanban, kalender, dan laporan.
            </p>
            <div class="feature-list">
                <div class="feature-item">
                    <span class="feature-icon">list</span>
                    <span class="feature-text">My Tasks</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">kanban</span>
                    <span class="feature-text">Kanban Board</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">calendar_month</span>
                    <span class="feature-text">Calendar</span>
                </div>
                <div class="feature-item">
                    <span class="feature-icon">analytics</span>
                    <span class="feature-text">Reports</span>
                </div>
            </div>
        </div>
        <!-- Right Side - Login Card -->
        <div class="login-right">
            <div class="login-card">
                <div class="login-header">
                    <div class="logo-icon" style="width:48px;height:48px;font-size:26px;">
                        <span class="material-icons-round">task_alt</span>
                    </div>
                    <div class="login-header-text">
                        <h1 style="font-size:20px;">Selamat Datang Kembali</h1>
                        <p style="font-size:14px;color:var(--text-secondary);">Masuk untuk mengelola tugas dan proyekmu.</p>
                    </div>
                    <span class="material-icons-round" style="cursor:pointer;color:var(--text-secondary);font-size:24px;" onclick="toggleSidebar()">menu</span>
                </div>

                <div class="login-body">
                    <form id="login-form" novalidate>
                        <div class="form-group">
                            <label for="login-email" class="form-label">Email Anda</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <span class="material-icons-round">email</span>
                                </span>
                                <input type="email" id="login-email" autocomplete="email" placeholder="email@perusahaan.com">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="login-password" class="form-label">Kata Sandi</label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <span class="material-icons-round">lock</span>
                                </span>
                                <input type="password" id="login-password" autocomplete="current-password" placeholder="••••••••">
                                <span class="toggle-password" onclick="toggleLoginPassword()">
                                    <span class="material-icons-round">visibility</span>
                                </span>
                            </div>
                            <div class="password-hint">Lupa kata sandi? <a href="#" onclick="event.preventDefault();showForgotPassword();">Lupa Password?</a></div>
                        </div>
                        <div class="form-options">
                            <input type="checkbox" id="login-remember">
                            <label for="login-remember" style="font-size:13px;color:var(--text-secondary);">Ingatkannya</label>
                        </div>
                        <button type="submit" class="btn-login" id="login-submit">
                            <span class="btn-text">Masuk</span>
                            <span class="btn-loading"></span>
                        </button>
                        <div class="auth-links">
                            <span class="auth-text">Belum punya akun? <a href="#" onclick="event.preventDefault();document.getElementById('login-screen').classList.add('hidden');document.getElementById('app-container').classList.remove('hidden');showRegister();">Daftar sekarang</a></span>
                        </div>
                    </form>
                    <div id="login-error" class="error-msg" style="color:#FCA5A5;font-size:13px;margin-top:12px;display:none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="app-container" style="display:none;">
    <div id="sidebar-overlay"></div>
    <aside id="sidebar">
        <div class="logo-area">
            <div class="logo-icon">
                <span class="material-icons-round">task_alt</span>
            </div>
            <div class="logo-text">
                <span class="app-name">ManageTugas</span>
                <span class="app-tag">Project Board</span>
            </div>
            <span class="material-icons-round" style="cursor:pointer;color:var(--text-secondary);font-size:22px;" onclick="toggleSidebar()">menu</span>
        </div>
        <nav class="nav">
            <button class="nav-btn active" data-tab="dashboard" onclick="switchTab('dashboard')">
                <span class="nav-icon" style="background:rgba(59,130,246,0.18);"><span class="material-icons-round">dashboard</span></span>
                <span>Dashboard</span>
            </button>
            <button class="nav-btn" data-tab="kanban" onclick="switchTab('kanban')">
                <span class="nav-icon" style="background:rgba(245,158,11,0.18);"><span class="material-icons-round">kanban</span></span>
                <span>Kanban Board</span>
            </button>
            <button class="nav-btn" data-tab="tasks" onclick="switchTab('tasks')">
                <span class="nav-icon" style="background:rgba(16,185,129,0.18);"><span class="material-icons-round">list</span></span>
                <span>My Tasks</span>
            </button>
            <button class="nav-btn" data-tab="calendar" onclick="switchTab('calendar')">
                <span class="nav-icon" style="background:rgba(59,130,246,0.18);"><span class="material-icons-round">calendar_month</span></span>
                <span>Calendar</span>
            </button>
            <button class="nav-btn" data-tab="reports" onclick="switchTab('reports')">
                <span class="nav-icon" style="background:rgba(139,92,246,0.18);"><span class="material-icons-round">analytics</span></span>
                <span>Reports / Analytics</span>
            </button>
            <button class="nav-btn" data-tab="settings" onclick="switchTab('settings')">
                <span class="nav-icon" style="background:rgba(255,255,255,0.08);"><span class="material-icons-round">settings</span></span>
                <span>Settings</span>
            </button>
        </nav>
        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar" id="sidebar-user-avatar">U</div>
                <div class="user-info">
                    <div class="name" id="sidebar-user-name">User Name</div>
                    <div class="role" id="sidebar-user-role">Owner</div>
                </div>
                <span class="material-icons-round" style="color:var(--text-secondary);">keyboard_arrow_right</span>
            </div>
            <button class="logout-btn" onclick="handleLogout()">
                <span class="material-icons-round">logout</span>
                <span>Keluar</span>
            </button>
        </div>
    </aside>

    <main id="main-content">
        <div class="content-area">

            <!-- DASHBOARD -->
            <div id="tab-dashboard" class="tab-content">
                <div class="page-header">
                    <div>
                        <h1 id="page-title">Dashboard</h1>
                        <p class="sub" id="page-desc">Ringkasan aktivitas dan statistik terkini, kemudian kembangkan ke kanban harian.</p>
                    </div>
                    <div class="header-actions">
                        <span class="material-icons-round text-slate-400" style="cursor:pointer;" onclick="showQuickHelp()">help_outline</span>
                    </div>
                </div>

                <div class="activity-feed">
                    <div class="activity-item">
                        <div class="act-icon" style="background:rgba(59,130,246,0.12);color:#3B82F6;">
                            <span class="material-icons-round">person</span>
                        </div>
                        <div class="act-body">
                            <div class="act-text" id="greeting-message">Selamat datang, Owner! 👋</div>
                            <div class="act-time" id="greeting-time">Hari ini, tanggal <span id="today-date"></span></div>
                        </div>
                    </div>
                </div>

                <div class="stats-grid" id="dashboard-stats">
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(59,130,246,0.14);color:#3B82F6;">
                            <span class="material-icons-round">assignment</span>
                        </div>
                        <div class="stat-label">Total Tasks</div>
                        <div class="stat-number" id="stat-total-tasks">0</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(16,185,129,0.14);color:#10B981;">
                            <span class="material-icons-round">check_circle</span>
                        </div>
                        <div class="stat-label">Completed</div>
                        <div class="stat-number" id="stat-completed">0</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(245,158,11,0.14);color:#F59E0B;">
                            <span class="material-icons-round">schedule</span>
                        </div>
                        <div class="stat-label">In Progress</div>
                        <div class="stat-number" id="stat-in-progress">0</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon" style="background:rgba(239,68,68,0.14);color:#EF4444;">
                            <span class="material-icons-round">warning</span>
                        </div>
                        <div class="stat-label">Overdue</div>
                        <div class="stat-number" id="stat-overdue">0</div>
                    </div>
                </div>

                <div class="kanban-wrapper" id="kanban-section">
                    <div class="kanban-header">
                        <h2>
                            <span class="material-icons-round" style="color:#F59E0B;">kanban</span>
                            Kanban Board
                        </h2>
                        <div class="header-actions">
                            <div class="kanban-filters" style="display:flex;gap:8px;flex-wrap:wrap;">
                                <input type="text" id="kanban-search" oninput="applyKanbanFilters()" placeholder="Cari tugas..." style="background:var(--bg);border:1px solid rgba(255,255,255,0.10);color:#fff;padding:8px 12px;border-radius:8px;outline:none;transition:border-color 0.2s;">
                                <select id="kanban-status-filter" onchange="applyKanbanFilters()" style="background:var(--bg);border:1px solid rgba(255,255,255,0.10);color:#fff;padding:8px 36px 8px 12px;border-radius:8px;outline:none;cursor:pointer;">
                                    <option value="">Semua Status</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Proses">Proses</option>
                                    <option value="Selesai">Selesai</option>
                                </select>
                                <select id="kanban-priority-filter" onchange="applyKanbanFilters()" style="background:var(--bg);border:1px solid rgba(255,255,255,0.10);color:#fff;padding:8px 36px 8px 12px;border-radius:8px;outline:none;cursor:pointer;">
                                    <option value="">Semua Prioritas</option>
                                    <option value="High">High</option>
                                    <option value="Medium">Medium</option>
                                    <option value="Low">Low</option>
                                </select>
                            </div>
                            <button onclick="openModal('task','create')" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition flex items-center gap-2">
                                <span class="material-icons-round">add</span>
                                <span>Tambah Tugas</span>
                            </button>
                        </div>
                    </div>
                    <div class="kanban-columns" id="kanban-columns">
                        <div class="kanban-column" data-status="Pending">
                            <div class="column-header">
                                <span class="col-title">
                                    <span class="material-icons-round" style="color:#374151;">queue</span>
                                    To Do
                                </span>
                                <span class="col-count" id="count-todo">0</span>
                            </div>
                            <div class="kanban-cards" id="kanban-todo">
                                <div class="empty-state" style="text-align:center;padding:24px;color:var(--text-light);">
                                    <span class="material-icons-round" style="font-size:32px;color:var(--text-secondary);margin-bottom:8px;">inbox</span>
                                    <p style="font-size:13px;">Belum ada tugas di kolom ini.</p>
                                </div>
                            </div>
                        </div>
                        <div class="kanban-column" data-status="Proses">
                            <div class="column-header">
                                <span class="col-title">
                                    <span class="material-icons-round" style="color:#F59E0B;">schedule</span>
                                    In Progress
                                </span>
                                <span class="col-count" id="count-in-progress">0</span>
                            </div>
                            <div class="kanban-cards" id="kanban-in-progress">
                                <div class="empty-state" style="text-align:center;padding:24px;color:var(--text-light);">
                                    <span class="material-icons-round" style="font-size:32px;color:var(--text-secondary);margin-bottom:8px;">sync</span>
                                    <p style="font-size:13px;">Tugas sedang berjalan.</p>
                                </div>
                            </div>
                        </div>
                        <div class="kanban-column" data-status="Selesai">
                            <div class="column-header">
                                <span class="col-title">
                                    <span class="material-icons-round" style="color:#10B981;">check_circle</span>
                                    Done
                                </span>
                                <span class="col-count" id="count-done">0</span>
                            </div>
                            <div class="kanban-cards" id="kanban-done">
                                <div class="empty-state" style="text-align:center;padding:24px;color:var(--text-light);">
                                    <span class="material-icons-round" style="font-size:32px;color:var(--text-secondary);margin-bottom:8px;">done</span>
                                    <p style="font-size:13px;">Tugas selesai.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6">
                    <div class="calendar-card">
                        <div class="cal-header">
                            <h3 style="font-size:16px;font-weight:700;color:#fff;margin:0;display:flex;align-items:center;gap:8px;">
                                <span class="material-icons-round" style="color:#3B82F6;">calendar_month</span>
                                Calendar
                            </h3>
                            <div class="cal-nav">
                                <button onclick="prevMonth()"><span class="material-icons-round">chevron_left</span></button>
                                <span id="calendar-month" style="font-size:14px;font-weight:700;color:#fff;">January 2026</span>
                                <button onclick="nextMonth()"><span class="material-icons-round">chevron_right</span></button>
                            </div>
                        </div>
                        <div class="calendar-grid" id="calendar-grid"></div>
                    </div>
                    <div class="reports-grid">
                        <div class="report-item">
                            <div class="report-header">
                                <span class="report-title">Task Completion</span>
                                <span class="chip" style="background:rgba(16,185,129,0.15);color:#10B981;"><span class="material-icons-round" style="font-size:14px;">pie_chart</span></span>
                            </div>
                            <div class="report-desc">Status penyelesaian tugas dan distribusi antar status.</div>
                            <div class="report-meta">
                                <span>Total: <strong id="report-total">0</strong></span>
                                <span>Selesai: <strong id="report-completed" style="color:#10B981;">0</strong></span>
                                <span>Proses: <strong id="report-in-progress" style="color:#F59E0B;">0</strong></span>
                                <span>Pending: <strong id="report-pending" style="color:#374151;">0</strong></span>
                            </div>
                        </div>
                        <div class="report-item">
                            <div class="report-header">
                                <span class="report-title">Deadline Analysis</span>
                                <span class="chip" style="background:rgba(59,130,246,0.15);color:#3B82F6;"><span class="material-icons-round" style="font-size:14px;">calendar_today</span></span>
                            </div>
                            <div class="report-desc">Rata-rata deadline dan tugas yang jatuh dalam 7 hari ke depan.</div>
                            <div class="report-meta">
                                <span>Avg Deadline: <strong id="report-avg-deadline">-</strong></span>
                                <span>Due This Week: <strong id="report-this-week" style="color:#F59E0B;">0</strong></span>
                                <span>Overdue: <strong id="report-overdue" style="color:#EF4444;">0</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TASKS TABLE -->
            <div id="tab-tasks" class="tab-content hidden">
                <div class="page-header">
                    <div>
                        <h1 id="page-title">My Tasks</h1>
                        <p class="sub">Kelola daftar tugas, filter, dan pantau kemajuan.</p>
                    </div>
                    <div class="header-actions">
                        <button onclick="openModal('task','create')" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition flex items-center gap-2">
                            <span class="material-icons-round">add</span>
                            <span>Tambah Tugas</span>
                        </button>
                    </div>
                </div>
                <div class="table-card">
                    <div class="table-header">
                        <div class="search-box" style="display:flex;gap:10px;flex-wrap:wrap;">
                            <input type="text" id="search-tasks" oninput="renderTasksTable()" placeholder="Cari tugas..." style="flex:1;min-width:200px;padding:10px 14px;border-radius:8px;border:1px solid rgba(255,255,255,0.10);background:var(--bg);color:#fff;outline:none;">
                            <select id="filter-task-status" onchange="renderTasksTable()" style="padding:10px 32px 10px 12px;border-radius:8px;border:1px solid rgba(255,255,255,0.10);background:var(--bg);color:#fff;outline:none;cursor:pointer;">
                                <option value="">Semua Status</option>
                                <option value="Pending">Pending</option>
                                <option value="Proses">Proses</option>
                                <option value="Selesai">Selesai</option>
                            </select>
                        </div>
                    </div>
                    <div class="table-wrap">
                        <table id="tasks-table">
                            <thead>
                                <tr>
                                    <th>Judul</th>
                                    <th>Deskripsi</th>
                                    <th>Deadline</th>
                                    <th>Status</th>
                                    <th>Prioritas</th>
                                    <th>Aksi</th>
                                </tr>
                            </thead>
                            <tbody id="tasks-table-body">
                                <tr><td colspan="6" style="text-align:center;color:var(--text-secondary);padding:32px;">Memuat daftar tugas...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- KANBAN BOARD -->
            <div id="tab-kanban" class="tab-content hidden">
                <div class="page-header">
                    <div>
                        <h1 id="page-title">Kanban Board</h1>
                        <p class="sub">Papan kanban inti untuk mengelola tugas per kategori.</p>
                    </div>
                    <div class="header-actions">
                        <button onclick="openModal('task','create')" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition flex items-center gap-2">
                            <span class="material-icons-round">add</span>
                            <span>Tambah Tugas</span>
                        </button>
                    </div>
                </div>
                <div class="kanban-wrapper">
                    <div class="kanban-header">
                        <h2>
                            <span class="material-icons-round" style="color:#F59E0B;">kanban</span>
                            Papan Kanban
                        </h2>
                        <div class="header-actions">
                            <div class="kanban-filters" style="display:flex;gap:8px;flex-wrap:wrap;">
                                <input type="text" id="kanban-search2" oninput="applyKanbanFilters()" placeholder="Cari tugas..." style="background:var(--bg);border:1px solid rgba(255,255,255,0.10);color:#fff;padding:8px 12px;border-radius:8px;outline:none;transition:border-color 0.2s;">
                            </div>
                            <button onclick="openModal('task','create')" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition flex items-center gap-2">
                                <span class="material-icons-round">add</span>
                                <span>Tambah Tugas</span>
                            </button>
                        </div>
                    </div>
                    <div class="kanban-columns" id="kanban-columns">
                        <div class="kanban-column" data-status="Pending">
                            <div class="column-header">
                                <span class="col-title">
                                    <span class="material-icons-round" style="color:#374151;">queue</span>
                                    To Do
                                </span>
                                <span class="col-count" id="count-todo2">0</span>
                            </div>
                            <div class="kanban-cards" id="kanban-todo2">
                                <div class="empty-state" style="text-align:center;padding:24px;color:var(--text-light);">
                                    <span class="material-icons-round" style="font-size:32px;color:var(--text-secondary);margin-bottom:8px;">inbox</span>
                                    <p style="font-size:13px;">Belum ada tugas di sini.</p>
                                </div>
                            </div>
                        </div>
                        <div class="kanban-column" data-status="Proses">
                            <div class="column-header">
                                <span class="col-title">
                                    <span class="material-icons-round" style="color:#F59E0B;">schedule</span>
                                    In Progress
                                </span>
                                <span class="col-count" id="count-in-progress2">0</span>
                            </div>
                            <div class="kanban-cards" id="kanban-in-progress2">
                                <div class="empty-state" style="text-align:center;padding:24px;color:var(--text-light);">
                                    <span class="material-icons-round" style="font-size:32px;color:var(--text-secondary);margin-bottom:8px;">sync</span>
                                    <p style="font-size:13px;">Tugas sedang berjalan.</p>
                                </div>
                            </div>
                        </div>
                        <div class="kanban-column" data-status="Selesai">
                            <div class="column-header">
                                <span class="col-title">
                                    <span class="material-icons-round" style="color:#10B981;">check_circle</span>
                                    Done
                                </span>
                                <span class="col-count" id="count-done2">0</span>
                            </div>
                            <div class="kanban-cards" id="kanban-done2">
                                <div class="empty-state" style="text-align:center;padding:24px;color:var(--text-light);">
                                    <span class="material-icons-round" style="font-size:32px;color:var(--text-secondary);margin-bottom:8px;">done</span>
                                    <p style="font-size:13px;">Tugas selesai.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CALENDAR -->
            <div id="tab-calendar" class="tab-content hidden">
                <div class="page-header">
                    <div>
                        <h1 id="page-title">Calendar</h1>
                        <p class="sub">Lihat semua deadline tugas dalam kalender bulanan.</p>
                    </div>
                    <div class="header-actions">
                        <button onclick="openModal('task','create')" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white text-sm font-semibold px-4 py-2.5 rounded-xl shadow-lg shadow-blue-500/20 transition flex items-center gap-2">
                            <span class="material-icons-round">add</span>
                            <span>Tambah Tugas</span>
                        </button>
