/* ============================================
   ManageTugas — Modern SaaS Design System
   Inspired by Linear & Notion
   ============================================ */

:root {
    /* Colors */
    --bg: #F8FAFC;
    --sidebar: #0F172A;
    --sidebar-hover: #1E293B;
    --card: #FFFFFF;
    --card-hover: #F1F5F9;
    --primary: #3B82F6;
    --primary-hover: #2563EB;
    --primary-light: #DBEAFE;
    --heading: #0F172A;
    --text: #334155;
    --text-secondary: #64748B;
    --text-light: #94A3B8;
    --border: #E2E8F0;
    --border-focus: #3B82F6;
    --success: #16A34A;
    --success-light: #DCFCE7;
    --warning: #F59E0B;
    --warning-light: #FEF3C7;
    --danger: #EF4444;
    --danger-light: #FEE2E2;
    --radius: 12px;
    --radius-sm: 8px;
    --shadow-card: 0 1px 3px rgba(15, 23, 42, 0.08), 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-card-hover: 0 4px 16px rgba(15, 23, 42, 0.10);
    --shadow-modal: 0 20px 60px rgba(15, 23, 42, 0.20);
    --font: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}

/* Reset */
* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--font);
    font-size: 14px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
}

/* Scrollbar */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: #F1F5F9; border-radius: 3px; }
::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: #94A3B8; }

/* Typography */
h1, h2, h3, h4, h5, h6 { font-weight: 700; color: var(--heading); line-height: 1.3; }
h1 { font-size: 28px; }
h2 { font-size: 22px; }
h3 { font-size: 18px; }
h4 { font-size: 15px; }
p { color: var(--text-secondary); }
a { color: var(--primary); text-decoration: none; }
a:hover { text-decoration: underline; }

/* Login Page */
#login-overlay-backdrop {
    position: fixed; inset: 0; z-index: 999;
    background: radial-gradient(ellipse 50% 40% at 8% 10%, rgba(59, 130, 246, 0.15) 0%, transparent 60%),
                radial-gradient(ellipse 40% 30% at 92% 15%, rgba(16, 185, 129, 0.12) 0%, transparent 60%),
                radial-gradient(ellipse 30% 25% at 85% 85%, rgba(139, 92, 246, 0.10) 0%, transparent 60%);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
}
#login-overlay-backdrop::before {
    content: '';
    position: absolute;
    width: 600px; height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(59, 130, 246, 0.15), transparent 70%);
    top: -200px; left: -200px;
    pointer-events: none;
}
#login-overlay-backdrop::after {
    content: '';
    position: absolute;
    width: 400px; height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle at 70% 70%, rgba(16, 185, 129, 0.15), transparent 70%);
    bottom: -150px; right: -150px;
    pointer-events: none;
}
#login-screen {
    width: min(420px, 94vw); max-height: 90vh; overflow-y: auto;
    background: var(--card); border: 1px solid rgba(255, 255, 255, 0.10);
    border-radius: var(--radius); box-shadow: var(--shadow-modal);
    padding: 40px 36px; position: relative;
    backdrop-filter: blur(20px);
}
.login-layout {
    display: flex; align-items: stretch; gap: 28px;
    min-height: 100vh; padding: 32px 28px; background: var(--bg);
}
.login-left {
    flex: 1.2; display: flex; flex-direction: column; justify-content: center; padding: 0;
}
.login-left .subtitle {
    color: var(--text-secondary); font-size: 16px; line-height: 1.8; margin-bottom: 28px;
}
.login-left .feature-list {
    display: flex; flex-direction: column; gap: 16px; margin-top: 36px;
}
.login-left .feature-item {
    display: flex; align-items: center; gap: 14px;
    color: var(--text-secondary); font-size: 14px; font-weight: 500;
    padding: 14px 18px; border-radius: var(--radius-sm); transition: background 0.2s, color 0.2s;
}
.login-left .feature-item:hover { background: rgba(255, 255, 255, 0.08); color: #E2E8F0; }
.login-left .feature-icon {
    width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center;
    font-size: 20px; color: var(--text-secondary); background: rgba(255, 255, 255, 0.10);
    transition: background 0.2s, color 0.2s;
}
.login-left .feature-item:hover .feature-icon { background: rgba(59, 130, 246, 0.12); color: #3B82F6; }
.login-right {
    flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 0;
}
.login-header {
    text-align: center; padding-bottom: 36px; border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.login-header .logo-icon {
    width: 56px; height: 56px; border-radius: 14px;
    background: linear-gradient(135deg, var(--primary), #2563EB);
    display: flex; align-items: center; justify-content: center; color: #fff;
    font-size: 30px; box-shadow: 0 12px 28px -8px rgba(59, 130, 246, 0.5);
    margin-bottom: 16px;
}
.login-header-text h1 { font-size: 26px; font-weight: 800; color: #fff; margin: 0 0 6px; letter-spacing: -1px; }
.login-header-text p { font-size: 15px; color: #93C5FD; margin: 0; }
.login-body { padding-top: 8px; }
.form-group { margin-bottom: 22px; }
.form-label {
    display: block; font-size: 12px; font-weight: 600; color: var(--text-secondary);
    margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.8px;
}
.input-wrapper { position: relative; }
.input-wrapper input {
    width: 100%; padding: 14px 18px 14px 48px; border-radius: 12px;
    background: var(--card); border: 1.5px solid var(--border); color: var(--text);
    font-size: 15px; outline: none; transition: border-color 0.25s, box-shadow 0.25s;
}
.input-wrapper input:focus {
    border-color: var(--primary); box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12);
}
.input-wrapper input::placeholder { color: var(--text-light); font-weight: 400; }
.input-wrapper .input-icon {
    position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
    color: var(--text-light); font-size: 21px; pointer-events: none;
    transition: color 0.2s;
}
.input-wrapper input:focus + .input-icon,
.input-wrapper .input-icon { color: var(--primary); }
.input-wrapper .toggle-password {
    position: absolute; right: 16px; top: 50%; transform: translateY(-50%);
    color: var(--text-light); cursor: pointer; font-size: 20px;
    transition: color 0.2s, transform 0.2s;
}
.input-wrapper .toggle-password:hover { color: var(--text); transform: translateY(-50%) scale(1.1); }
.password-hint {
    font-size: 13px; color: var(--text-secondary); margin-top: 10px; display: flex; align-items: center;
}
.password-hint a { color: var(--primary); font-weight: 600; text-decoration: none; }
.password-hint a:hover { text-decoration: underline; }
.form-options { display: flex; align-items: center; gap: 14px; margin-bottom: 24px; padding: 0; }
.form-options input { accent-color: var(--primary); }
.form-options input[type="checkbox"] { width: auto; }
.btn-login {
    width: 100%; padding: 16px; border-radius: 12px;
    background: linear-gradient(135deg, #3B82F6 0%, #2563EB 50%, #1D4ED8 100%);
    color: #fff; font-weight: 700; font-size: 16px; border: none; cursor: pointer;
    transition: transform 0.25s, box-shadow 0.25s, filter 0.25s;
    display: flex; align-items: center; justify-content: center; gap: 10px;
}
.btn-login:hover { transform: translateY(-2px); box-shadow: 0 16px 32px -8px rgba(59, 130, 246, 0.55); filter: brightness(1.05); }
.btn-login:active { transform: translateY(0) scale(0.98); }
.btn-login:focus { outline: none; box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.20); }
.btn-loading { display: none; width: 18px; height: 18px; border: 2px solid rgba(255, 255, 255, 0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; margin-left: 8px; }
.btn-login.loading .btn-text { display: none; }
.btn-login.loading .btn-loading { display: inline-block; }
@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
.auth-links { text-align: center; margin-top: 22px; font-size: 14px; color: var(--text-secondary); }
.auth-links a { color: var(--primary); font-weight: 600; text-decoration: none; }
.auth-links a:hover { text-decoration: underline; }
/* Abstract background shapes for login overlay */
#login-overlay-backdrop::after,
#login-overlay-backdrop::before {
    content: ''; position: absolute; border-radius: 50%; pointer-events: none;
}
#login-overlay-backdrop::before { width: 500px; height: 500px; background: radial-gradient(circle at 30% 30%, rgba(59, 130, 246, 0.12), transparent 70%); top: -150px; left: -150px; }
#login-overlay-backdrop::after { width: 400px; height: 400px; background: radial-gradient(circle at 70% 70%, rgba(16, 185, 129, 0.15), transparent 70%); bottom: -150px; right: -100px; }

/* Dashboard tags for login screen when opened from app */
#app-container:not(:empty) ~ .login-overlay-backdrop { display: none; }
#app-container:not(:empty) ~ .login-screen { display: none !important; }

/* App Container */
#app-container {
    display: flex; min-height: 100vh; overflow: hidden;
}

/* Sidebar */
#sidebar {
    width: 260px; background: var(--sidebar);
    display: flex; flex-direction: column; position: fixed; top: 0; left: 0; bottom: 0;
    z-index: 40; overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), width 0.3s ease;
}
#sidebar.collapsed { width: 72px; }
#sidebar .logo-area {
    padding: 20px 18px; display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}
#sidebar .logo-icon {
    width: 42px; height: 42px; border-radius: 12px;
    background: linear-gradient(135deg, var(--primary), #2563EB);
    display: flex; align-items: center; justify-content: center; color: #fff;
    font-size: 22px; box-shadow: 0 6px 16px -6px rgba(59, 130, 246, 0.4);
}
#sidebar .logo-text { display: flex; flex-direction: column; }
#sidebar .logo-text .app-name { font-weight: 700; font-size: 16px; color: #fff; letter-spacing: -0.5px; }
#sidebar .logo-text .app-tag { font-size: 10px; color: #64748B; letter-spacing: 1px; text-transform: uppercase; }
#sidebar .nav { flex: 1; padding: 12px 12px; display: flex; flex-direction: column; gap: 2px; overflow-y: auto; }
#sidebar .nav-btn {
    display: flex; align-items: center; gap: 12px; width: 100%;
    padding: 11px 14px; border-radius: var(--radius-sm); text-decoration: none;
    font-size: 14px; font-weight: 600; color: #94A3B8; background: transparent;
    border: none; cursor: pointer; transition: background 0.2s, color 0.2s;
    position: relative; text-align: left;
}
#sidebar .nav-btn:hover { background: rgba(255, 255, 255, 0.08); color: #F1F5F9; }
#sidebar .nav-btn.active {
    background: rgba(59, 130, 246, 0.16); color: #3B82F6;
    box-shadow: inset 3px 0 0 #3B82F6;
}
#sidebar .nav-btn .nav-icon {
    width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
    border-radius: 6px; font-size: 20px;
}
#sidebar .nav-btn.active .nav-icon { background: rgba(59, 130, 246, 0.20); }
#sidebar .sidebar-footer {
    padding: 14px; border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex; flex-direction: column; gap: 8px;
}
#sidebar .user-profile {
    display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: var(--radius-sm);
    cursor: pointer; transition: background 0.2s;
}
#sidebar .user-profile:hover { background: rgba(255, 255, 255, 0.08); }
#sidebar .user-avatar {
    width: 36px; height: 36px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), #2563EB);
    color: #fff; display: flex; align-items: center; justify-content: center;
    font-weight: 700; font-size: 14px; flex-shrink: 0;
}
#sidebar .user-info { flex: 1; min-width: 0; }
#sidebar .user-info .name { font-size: 13px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
#sidebar .user-info .role { font-size: 11px; color: #64748B; }
#sidebar .logout-btn {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; padding: 12px; border-radius: var(--radius-sm);
    font-size: 13px; font-weight: 600; color: #FCA5A5;
    background: rgba(239, 68, 68, 0.12); border: none; cursor: pointer;
    transition: background 0.2s;
}
#sidebar .logout-btn:hover { background: rgba(239, 68, 68, 0.20); color: #EF4444; }

/* Sidebar Overlay */
#sidebar-overlay {
    position: fixed; inset: 0; z-index: 35;
    background: rgba(0, 0, 0, 0.45); opacity: 0; pointer-events: none; transition: opacity 0.3s;
}
#sidebar-overlay.active { opacity: 1; pointer-events: auto; }

/* Main Content */
#main-content {
    flex: 1; margin-left: 260px; overflow: hidden; display: flex; flex-direction: column;
    background: var(--bg);
}
#main-content.expanded { margin-left: 72px; }
#main-content .content-area {
    padding: 28px 32px 36px; max-height: 100%; overflow-y: auto;
}

/* Page Header */
.page-header {
    display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
    gap: 20px; margin-bottom: 26px;
}
.page-header h1 { font-size: 26px; margin: 0; }
.page-header .sub { color: var(--text-secondary); font-size: 14px; margin-top: 4px; }
.header-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }

/* Blank state */
.empty-state {
    text-align: center; padding: 32px; color: var(--text-light);
    background: var(--card); border: 1px dashed var(--border); border-radius: var(--radius-sm);
}

/* Statistics Cards */
.stats-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px;
    margin-bottom: 28px;
}
.stat-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px 22px;
    box-shadow: var(--shadow-card); transition: box-shadow 0.2s, transform 0.2s;
}
.stat-card:hover { box-shadow: var(--shadow-card-hover); transform: translateY(-1px); }
.stat-card .stat-icon {
    width: 44px; height: 44px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center; font-size: 20px;
    margin-bottom: 14px;
}
.stat-card .stat-icon.success { background: var(--success-light); color: var(--success); }
.stat-card .stat-icon.warning { background: var(--warning-light); color: var(--warning); }
.stat-card .stat-icon.danger { background: var(--danger-light); color: var(--danger); }
.stat-card .stat-icon.primary { background: var(--primary-light); color: var(--primary); }
.stat-card .stat-label { font-size: 11px; font-weight: 600; color: var(--text-light); text-transform: uppercase; letter-spacing: 0.8px; }
.stat-card .stat-number { font-size: 32px; font-weight: 800; color: var(--heading); line-height: 1.1; margin-top: 4px; }
.stat-card .stat-trend { font-size: 12px; margin-top: 6px; display: flex; align-items: center; gap: 4px; color: var(--text-secondary); }

/* Kanban Board */
.kanban-wrapper {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-card);
}
.kanban-header {
    padding: 20px 24px; display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 16px; border-bottom: 1px solid var(--border);
}
.kanban-header h2 { font-size: 18px; font-weight: 700; color: var(--heading); margin: 0; display: flex; align-items: center; gap: 8px; }
.kanban-header .header-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }
.kanban-filters { display: flex; gap: 8px; flex-wrap: wrap; }
.kanban-filters input, .kanban-filters select {
    padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--card); color: var(--text); font-size: 13px; outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.kanban-filters input:focus, .kanban-filters select:focus {
    border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.btn-primary {
    padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 14px;
    background: linear-gradient(135deg, var(--primary), #2563EB); color: #fff;
    border: none; cursor: pointer; display: flex; align-items: center; gap: 8px;
    transition: box-shadow 0.2s, transform 0.2s;
}
.btn-primary:hover { box-shadow: 0 4px 12px rgba(59, 130, 246, 0.35); transform: translateY(-1px); }
.btn-primary:active { transform: translateY(0); }
.btn-secondary {
    padding: 10px 20px; border-radius: 8px; font-weight: 600; font-size: 14px;
    background: var(--bg); color: var(--text); border: 1px solid var(--border);
    cursor: pointer; display: flex; align-items: center; gap: 8px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.btn-secondary:hover { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.10); }

.kanban-columns { display: flex; gap: 20px; padding: 20px 24px; flex-wrap: wrap; }
.kanban-column {
    flex: 1; min-width: 300px; max-width: 420px; display: flex; flex-direction: column;
    background: var(--bg); border-radius: var(--radius-sm); overflow: hidden;
    border: 1px solid var(--border); transition: box-shadow 0.2s;
}
.kanban-column.drag-over { box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.4); }
.column-header {
    padding: 14px 16px; display: flex; align-items: center; justify-content: space-between;
    gap: 12px; border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.column-header .col-title { display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; color: var(--heading); }
.column-header .col-count {
    font-size: 12px; font-weight: 700; padding: 2px 8px; border-radius: 999px;
    background: var(--bg); color: var(--text-secondary); border: 1px solid var(--border);
}
.kanban-cards { flex: 1; padding: 12px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; min-height: 120px; }
.kanban-card {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm);
    padding: 14px 16px; cursor: grab; transition: transform 0.15s, box-shadow 0.15s;
    position: relative; touch-action: none; user-select: none;
}
.kanban-card:hover { box-shadow: var(--shadow-card); transform: translateY(-1px); }
.kanban-card:active { cursor: grabbing; }
.kanban-card .card-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.kanban-card .card-title { font-weight: 600; font-size: 14px; color: var(--heading); margin-bottom: 6px; line-height: 1.3; }
.kanban-card .card-desc { font-size: 12px; color: var(--text-secondary); line-height: 1.4; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 11px; }
.card-meta .meta-item { display: flex; align-items: center; gap: 4px; color: var(--text-light); white-space: nowrap; }
.card-actions { position: absolute; top: 8px; right: 8px; display: flex; gap: 4px; opacity: 0; transition: opacity 0.2s; }
.kanban-card:hover .card-actions { opacity: 1; }
.card-actions button {
    width: 28px; height: 28px; border-radius: 8px; border: none;
    background: rgba(15, 23, 42, 0.85); color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 18px;
    transition: background 0.2s, transform 0.15s;
}
.card-actions button:hover { background: rgba(255, 255, 255, 0.15); transform: scale(1.1); }
.kanban-card .chip {
    display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 999px;
    font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
}
.chip-status-pending { background: var(--warning-light); color: #B45309; }
.chip-status-in-progress { background: var(--primary-light); color: #1D4ED8; }
.chip-status-done { background: var(--success-light); color: var(--success); }
.chip-priority-high { background: var(--danger-light); color: #B91C1C; }
.chip-priority-medium { background: var(--warning-light); color: #B45309; }
.chip-priority-low { background: var(--success-light); color: var(--success); }

/* Calendar */
.calendar-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-card);
}
.calendar-card .cal-header {
    padding: 18px 20px; display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid var(--border);
}
.calendar-card .cal-header h3 { font-size: 16px; font-weight: 700; color: var(--heading); margin: 0; display: flex; align-items: center; gap: 8px; }
.cal-nav { display: flex; gap: 6px; }
.cal-nav button {
    width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--bg); color: var(--text); cursor: pointer;
    display: flex; align-items: center; justify-content: center; font-size: 18px;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.cal-nav button:hover { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.10); }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }
.cal-day-label {
    text-align: center; font-size: 11px; font-weight: 700; color: var(--text-light);
    text-transform: uppercase; letter-spacing: 0.5px; padding: 10px;
}
.cal-day {
    text-align: center; padding: 6px; cursor: pointer; border-radius: var(--radius-sm);
    transition: background 0.15s; border: 1px solid transparent;
}
.cal-day:hover { background: var(--bg); }
.cal-day.today { background: var(--primary-light); border-color: rgba(59, 130, 246, 0.3); color: var(--primary); font-weight: 700; }
.cal-day.other-month { color: var(--text-light); }
.cal-day .day-num { font-size: 13px; font-weight: 600; color: var(--text); }
.cal-day .day-dot { display: inline-block; width: 5px; height: 5px; border-radius: 50%; margin-top: 3px; }
.cal-day.task-day { border-color: rgba(59, 130, 246, 0.3); background: rgba(59, 130, 246, 0.06); }

/* Reports */
.reports-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
.report-item {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 20px; transition: box-shadow 0.2s;
}
.report-item:hover { box-shadow: var(--shadow-card); }
.report-item .report-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 10px; }
.report-item .report-title { font-weight: 700; font-size: 15px; color: var(--heading); }
.report-item .report-desc { font-size: 13px; color: var(--text-secondary); line-height: 1.5; }
.report-item .report-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 14px;
    padding-top: 14px; border-top: 1px solid var(--border); font-size: 12px; color: var(--text-light);
}

/* Tasks Table */
.table-card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-card);
}
.table-card .table-header {
    padding: 18px 20px; display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--border);
}
.table-card .table-header h3 { font-size: 16px; font-weight: 700; color: var(--heading); margin: 0; }
.search-box { display: flex; gap: 10px; flex-wrap: wrap; }
.search-box input, .search-box select {
    padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border);
    background: var(--bg); color: var(--text); font-size: 14px; outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}
.search-box input:focus, .search-box select:focus {
    border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; font-size: 14px; }
th { text-align: left; padding: 14px 16px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-light); border-bottom: 1px solid var(--border); }
td { padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
tr:last-child td { border-bottom: none; }
tr:hover td { background: var(--bg); }

/* Activity Feed */
.activity-feed {
    background: var(--card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow-card);
}
.activity-feed h3 { font-size: 16px; font-weight: 700; color: var(--heading); margin-bottom: 16px; }
.activity-item { display: flex; gap: 14px; padding: 14px 0; border-bottom: 1px solid var(--border); }
.activity-item:last-child { border-bottom: none; }
.activity-item .act-icon {
    width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center;
    justify-content: center; font-size: 16px; flex-shrink: 0;
}
.activity-item .act-body { flex: 1; min-width: 0; }
.activity-item .act-body .act-text { font-size: 14px; font-weight: 500; color: var(--heading); }
.activity-item .act-body .act-time { font-size: 11px; color: var(--text-light); margin-top: 2px; }

/* Modal */
#modal-form {
    position: fixed; inset: 0; z-index: 100; display: flex;
    align-items: center; justify-content: center;
    background: rgba(15, 23, 42, 0.60); backdrop-filter: blur(6px);
    opacity: 1; visibility: visible; transition: opacity 0.25s, visibility 0.25s;
}
#modal-form.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
#modal-form .modal-panel {
    width: min(560px, 94vw); max-height: 90vh; overflow-y: auto;
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow-modal); padding: 28px 32px;
}
#modal-form .modal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }
#modal-form .modal-header h3 { font-size: 20px; font-weight: 800; color: var(--heading); margin: 0; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-group.full { grid-column: 1 / -1; }
.form-group label { display: block; font-size: 12px; font-weight: 600; color: var(--text-light); margin-bottom: 6px; }
.form-group input, .form-group textarea, .form-group select {
    width: 100%; padding: 11px 14px; border-radius: var(--radius-sm);
    background: var(--bg); border: 1px solid var(--border); color: var(--text);
    font-size: 14px; outline: none; transition: border-color 0.2s, box-shadow 0.2s;
}
.form-group input:focus, .form-group textarea:focus, .form-group select:focus {
    border-color: var(--primary); box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
}
.form-group textarea { resize: vertical; min-height: 80px; }
.modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }

/* Toast */
#toast-container {
    position: fixed; bottom: 20px; right: 20px; z-index: 200;
    display: flex; flex-direction: column; gap: 10px;
}
.toast {
    padding: 14px 18px; border-radius: var(--radius-sm); border: 1px solid var(--border);
    box-shadow: var(--shadow-card); font-size: 14px; font-weight: 500;
    display: flex; align-items: center; gap: 10px; animation: slideIn 0.3s ease; max-width: 420px;
}
.toast.success { border-color: rgba(22, 163, 74, 0.3); background: var(--success-light); color: #166534; }
.toast.error { border-color: rgba(239, 68, 68, 0.3); background: var(--danger-light); color: #991B1B; }
.toast.info { border-color: rgba(59, 130, 246, 0.2); background: #EFF6FF; color: #1D4ED8; }
@keyframes slideIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }

/* Responsive */
@media (max-width: 1024px) {
    #sidebar { transform: translateX(-100%); }
    #sidebar.open { transform: translateX(0); }
    #main-content { margin-left: 0; }
    #main-content.expanded { margin-left: 0; }
    .content-area { padding: 20px 18px 32px; }
    .kanban-columns { flex-direction: column; }
    .kanban-column { min-width: 100%; max-width: 100%; }
}
@media (max-width: 640px) {
    #main-content .content-area { padding: 16px 14px 24px; }
    .page-header h1 { font-size: 22px; }
    .stats-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .kanban-header { padding: 16px; }
    .kanban-columns { padding: 12px 16px; }
    .kanban-column { min-width: 260px; max-width: 100%; }
    .form-grid { grid-template-columns: 1fr; }
    .stat-card .stat-number { font-size: 26px; }
}
.btn-loading { pointer-events: none; }
.btn-loading::after {
    content: ''; display: inline-block; width: 14px; height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.3); border-top-color: #fff;
    border-radius: 50%; animation: spin 0.8s linear infinite; vertical-align: middle; margin-left: 6px;
}
@keyframes spin { to { transform: rotate(360deg); } }
.hidden { display: none !important; }
